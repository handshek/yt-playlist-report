# Server-only YouTube Data API credential. Never prefix this with VITE_.
YT_API_KEY=your_youtube_api_key

# Server-only token used to delete feedback after 90 days. Never prefix with VITE_.
NETLIFY_ACCESS_TOKEN=your_netlify_personal_access_token
VITE_KOFI_PAGE_ID=yourusername

# Optional: enable the self-hosted Counterscale deployment.
VITE_COUNTERSCALE_REPORTER_URL=https://ytpr-data.<account>.workers.dev/collect
VITE_COUNTERSCALE_SITE_ID=ytpr-production
