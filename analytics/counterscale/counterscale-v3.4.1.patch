+// @vitest-environment jsdom
+import { render, screen } from "@testing-library/react";
+import type { LoaderFunctionArgs } from "react-router";
+import { describe, expect, test, vi } from "vitest";
+import "vitest-dom/extend-expect";
+
+import { SeoFunnelSummary, loader } from "../resources.seo-funnel";
+import { createFetchResponse, getDefaultContext } from "./testutils";
+
+vi.mock("~/lib/auth", () => ({
+    requireAuth: vi.fn(),
+}));
+
+describe("Resources/SEO funnel route", () => {
+    test("returns aggregate conversion metrics from reserved events", async () => {
+        global.fetch = vi
+            .fn()
+            .mockResolvedValueOnce(
+                createFetchResponse({
+                    data: [
+                        { path: "/events/report-submit", count: "8" },
+                        { path: "/events/report-success", count: "6" },
+                        { path: "/events/feedback-open", count: "4" },
+                        { path: "/events/offer-view", count: "4" },
+                        { path: "/events/feedback-submit/yes", count: "3" },
+                        { path: "/events/feedback-submit/no", count: "1" },
+                        { path: "/events/offer-response/yes", count: "2" },
+                        { path: "/events/offer-response/maybe", count: "1" },
+                        {
+                            path: "/events/feedback-use-case/study-course",
+                            count: "3",
+                        },
+                        {
+                            path: "/events/feedback-helpful/duration-speed",
+                            count: "3",
+                        },
+                        {
+                            path: "/events/feedback-missing/schedule-calendar",
+                            count: "2",
+                        },
+                        {
+                            path: "/events/report-error/invalid-url",
+                            count: "1",
+                        },
+                        {
+                            path: "/events/content-cta/yt-playlist-report-vs-ytpla",
+                            count: "3",
+                        },
+                    ],
+                }),
+            )
+            .mockResolvedValueOnce(
+                createFetchResponse({
+                    data: [{ blob11: "producthunt", count: "9" }],
+                }),
+            );
+
+        const response = await loader({
+            ...getDefaultContext(),
+            request: {
+                url: "http://localhost:3000/resources/seo-funnel?site=ytpr-production&interval=30d",
+            },
+        } as unknown as LoaderFunctionArgs);
+
+        expect(response.seoFunnel).toEqual({
+            reportSubmits: 8,
+            reportSuccesses: 6,
+            reportErrors: { invalidUrl: 1, fetchFailed: 0 },
+            feedbackOpens: 4,
+            offerViews: 4,
+            feedbackSubmits: { yes: 3, no: 1 },
+            offerResponses: { yes: 2, maybe: 1, no: 0 },
+            useCases: [{ slug: "study-course", responses: 3 }],
+            helpfulReasons: [{ slug: "duration-speed", responses: 3 }],
+            missingReasons: [{ slug: "schedule-calendar", responses: 2 }],
+            acquisitionSources: [
+                {
+                    source: "producthunt",
+                    visitors: 9,
+                    reportSubmits: 0,
+                    reportSuccesses: 0,
+                    offerViews: 0,
+                    feedbackSubmits: 0,
+                },
+            ],
+            contentCtaClicks: [
+                { slug: "yt-playlist-report-vs-ytpla", clicks: 3 },
+            ],
+        });
+    });
+
+    test("renders submits, success rate, categorized errors, and CTA slugs", () => {
+        render(
+            <SeoFunnelSummary
+                metrics={{
+                    reportSubmits: 8,
+                    reportSuccesses: 6,
+                    reportErrors: { invalidUrl: 1, fetchFailed: 1 },
+                    feedbackOpens: 4,
+                    offerViews: 4,
+                    feedbackSubmits: { yes: 3, no: 1 },
+                    offerResponses: { yes: 2, maybe: 1, no: 1 },
+                    useCases: [{ slug: "study-course", responses: 3 }],
+                    helpfulReasons: [{ slug: "duration-speed", responses: 3 }],
+                    missingReasons: [
+                        { slug: "schedule-calendar", responses: 2 },
+                    ],
+                    acquisitionSources: [
+                        {
+                            source: "producthunt",
+                            visitors: 9,
+                            reportSubmits: 8,
+                            reportSuccesses: 6,
+                            offerViews: 4,
+                            feedbackSubmits: 4,
+                        },
+                    ],
+                    contentCtaClicks: [
+                        {
+                            slug: "yt-playlist-report-vs-ytpla",
+                            clicks: 3,
+                        },
+                    ],
+                }}
+            />,
+        );
+
+        expect(screen.getAllByText("8").length).toBeGreaterThan(0);
+        expect(screen.getAllByText("6").length).toBeGreaterThan(0);
+        expect(screen.getByText("75%")).toBeInTheDocument();
+        expect(screen.getByText("50% yes")).toBeInTheDocument();
+        expect(screen.getByText("Invalid URL")).toBeInTheDocument();
+        expect(screen.getByText("Fetch failed")).toBeInTheDocument();
+        expect(
+            screen.getByText("yt-playlist-report-vs-ytpla"),
+        ).toBeInTheDocument();
+        expect(screen.getAllByText("3").length).toBeGreaterThan(0);
+        expect(screen.getByText("study-course")).toBeInTheDocument();
+        expect(screen.getByText("duration-speed")).toBeInTheDocument();
+        expect(screen.getByText("schedule-calendar")).toBeInTheDocument();
+        expect(screen.getByText("producthunt")).toBeInTheDocument();
+        expect(screen.getByText("67%")).toBeInTheDocument();
+    });
+});
