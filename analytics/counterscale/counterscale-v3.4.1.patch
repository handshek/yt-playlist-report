+// @vitest-environment jsdom
+import { render, screen } from "@testing-library/react";
+import { describe, expect, test, vi } from "vitest";
+import "vitest-dom/extend-expect";
+
+import {
+    PlaylistMeasurementsTable,
+    loader,
+} from "../resources.playlist-measurements";
+import { createFetchResponse, getDefaultContext } from "./testutils";
+
+vi.mock("~/lib/auth", () => ({
+    requireAuth: vi.fn(),
+}));
+
+describe("Resources/Playlist measurements route", () => {
+    test("returns a ten-row page from the measurement query", async () => {
+        global.fetch = vi.fn().mockResolvedValue(
+            createFetchResponse({
+                data: [
+                    { path: "/playlist/PLabc", measurements: "12" },
+                ],
+            }),
+        );
+
+        const response = await loader({
+            ...getDefaultContext(),
+            request: {
+                url: "http://localhost:3000/resources/playlist-measurements?site=ytpr-production&interval=30d&page=1",
+            },
+        } as any);
+
+        expect(response).toEqual({
+            playlistMeasurements: [
+                { playlistId: "PLabc", measurements: 12 },
+            ],
+            page: 1,
+        });
+    });
+
+    test("renders exact IDs as YouTube playlist links", () => {
+        render(
+            <PlaylistMeasurementsTable
+                rows={[{ playlistId: "PLabc_123-xyz", measurements: 7 }]}
+            />,
+        );
+
+        expect(screen.getByText("PLabc_123-xyz")).toHaveAttribute(
+            "href",
+            "https://www.youtube.com/playlist?list=PLabc_123-xyz",
+        );
+        expect(screen.getByText("7")).toBeInTheDocument();
+    });
+});
