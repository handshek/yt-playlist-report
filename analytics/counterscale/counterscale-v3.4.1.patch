+// @vitest-environment jsdom
+import { render, screen } from "@testing-library/react";
+import type { LoaderFunctionArgs } from "react-router";
+import { describe, expect, test, vi } from "vitest";
+import "vitest-dom/extend-expect";
+
+import { SeoFunnelSummary, loader } from "../resources.seo-funnel";
+import { createFetchResponse, getDefaultContext } from "./testutils";
+
+vi.mock("~/lib/auth", () => ({
+    requireAuth: vi.fn(),
+}));
+
+describe("Resources/SEO funnel route", () => {
+    test("returns aggregate conversion metrics from reserved events", async () => {
+        global.fetch = vi.fn().mockResolvedValue(
+            createFetchResponse({
+                data: [
+                    { path: "/events/report-submit", count: "8" },
+                    { path: "/events/report-success", count: "6" },
+                    {
+                        path: "/events/report-error/invalid-url",
+                        count: "1",
+                    },
+                    {
+                        path: "/events/content-cta/yt-playlist-report-vs-ytpla",
+                        count: "3",
+                    },
+                ],
+            }),
+        );
+
+        const response = await loader({
+            ...getDefaultContext(),
+            request: {
+                url: "http://localhost:3000/resources/seo-funnel?site=ytpr-production&interval=30d",
+            },
+        } as unknown as LoaderFunctionArgs);
+
+        expect(response.seoFunnel).toEqual({
+            reportSubmits: 8,
+            reportSuccesses: 6,
+            reportErrors: { invalidUrl: 1, fetchFailed: 0 },
+            contentCtaClicks: [
+                { slug: "yt-playlist-report-vs-ytpla", clicks: 3 },
+            ],
+        });
+    });
+
+    test("renders submits, success rate, categorized errors, and CTA slugs", () => {
+        render(
+            <SeoFunnelSummary
+                metrics={{
+                    reportSubmits: 8,
+                    reportSuccesses: 6,
+                    reportErrors: { invalidUrl: 1, fetchFailed: 1 },
+                    contentCtaClicks: [
+                        {
+                            slug: "yt-playlist-report-vs-ytpla",
+                            clicks: 3,
+                        },
+                    ],
+                }}
+            />,
+        );
+
+        expect(screen.getByText("8")).toBeInTheDocument();
+        expect(screen.getByText("6")).toBeInTheDocument();
+        expect(screen.getByText("75%")).toBeInTheDocument();
+        expect(screen.getByText("Invalid URL")).toBeInTheDocument();
+        expect(screen.getByText("Fetch failed")).toBeInTheDocument();
+        expect(
+            screen.getByText("yt-playlist-report-vs-ytpla"),
+        ).toBeInTheDocument();
+        expect(screen.getByText("3")).toBeInTheDocument();
+    });
+});
