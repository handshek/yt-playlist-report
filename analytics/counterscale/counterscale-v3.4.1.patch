@@ -0,0 +1,136 @@
+import { useEffect } from "react";
+import { useFetcher } from "react-router";
+import type { LoaderFunctionArgs } from "react-router";
+
+import type { SeoFunnelMetrics } from "~/analytics/query";
+import { Card, CardContent, CardHeader, CardTitle } from "~/components/ui/card";
+import { requireAuth } from "~/lib/auth";
+import type { SearchFilters } from "~/lib/types";
+import { getFiltersFromSearchParams, paramsFromUrl } from "~/lib/utils";
+
+const emptyMetrics: SeoFunnelMetrics = {
+    reportSubmits: 0,
+    reportSuccesses: 0,
+    reportErrors: { invalidUrl: 0, fetchFailed: 0 },
+    contentCtaClicks: [],
+};
+
+export async function loader({ context, request }: LoaderFunctionArgs) {
+    await requireAuth(request, context.cloudflare.env);
+    const { analyticsEngine } = context;
+    const { interval, site } = paramsFromUrl(request.url);
+    const url = new URL(request.url);
+    const timezone = url.searchParams.get("timezone") || "UTC";
+    const filters = getFiltersFromSearchParams(url.searchParams);
+
+    return {
+        seoFunnel: await analyticsEngine.getSeoFunnelMetrics(
+            site,
+            interval,
+            timezone,
+            filters,
+        ),
+    };
+}
+
+export function SeoFunnelSummary({ metrics }: { metrics: SeoFunnelMetrics }) {
+    const completionRate = metrics.reportSubmits
+        ? `${Math.round((metrics.reportSuccesses / metrics.reportSubmits) * 100)}%`
+        : "—";
+
+    return (
+        <div className="space-y-6">
+            <dl className="grid gap-4 sm:grid-cols-3">
+                <div>
+                    <dt className="text-sm text-muted-foreground">Submits</dt>
+                    <dd className="text-3xl font-semibold">
+                        {metrics.reportSubmits}
+                    </dd>
+                </div>
+                <div>
+                    <dt className="text-sm text-muted-foreground">Successes</dt>
+                    <dd className="text-3xl font-semibold">
+                        {metrics.reportSuccesses}
+                    </dd>
+                </div>
+                <div>
+                    <dt className="text-sm text-muted-foreground">
+                        Completion rate
+                    </dt>
+                    <dd className="text-3xl font-semibold">{completionRate}</dd>
+                </div>
+            </dl>
+
+            <div className="grid gap-4 sm:grid-cols-2">
+                <div className="rounded border p-3">
+                    <div className="text-sm text-muted-foreground">
+                        Invalid URL
+                    </div>
+                    <div className="text-2xl font-semibold">
+                        {metrics.reportErrors.invalidUrl}
+                    </div>
+                </div>
+                <div className="rounded border p-3">
+                    <div className="text-sm text-muted-foreground">
+                        Fetch failed
+                    </div>
+                    <div className="text-2xl font-semibold">
+                        {metrics.reportErrors.fetchFailed}
+                    </div>
+                </div>
+            </div>
+
+            <table className="w-full text-sm">
+                <thead>
+                    <tr className="border-b text-left">
+                        <th className="pb-2 font-medium">Content CTA</th>
+                        <th className="pb-2 text-right font-medium">Clicks</th>
+                    </tr>
+                </thead>
+                <tbody>
+                    {metrics.contentCtaClicks.map(({ slug, clicks }) => (
+                        <tr key={slug} className="border-b last:border-0">
+                            <td className="py-2 pr-4">{slug}</td>
+                            <td className="py-2 text-right">{clicks}</td>
+                        </tr>
+                    ))}
+                </tbody>
+            </table>
+        </div>
+    );
+}
+
+export function SeoFunnelCard({
+    siteId,
+    interval,
+    filters,
+    timezone,
+}: {
+    siteId: string;
+    interval: string;
+    filters: SearchFilters;
+    timezone: string;
+}) {
+    const dataFetcher = useFetcher<typeof loader>();
+    const metrics = dataFetcher.data?.seoFunnel || emptyMetrics;
+
+    useEffect(() => {
+        dataFetcher.submit(
+            { site: siteId, interval, timezone, ...filters },
+            { method: "get", action: "/resources/seo-funnel" },
+        );
+        // dataFetcher is intentionally stable and omitted from dependencies.
+        // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [siteId, interval, filters, timezone]);
+
+    return (
+        <Card className={dataFetcher.state === "loading" ? "opacity-60" : ""}>
+            <CardHeader>
+                <CardTitle>SEO Conversion Funnel</CardTitle>
+            </CardHeader>
+            <CardContent>
+                <SeoFunnelSummary metrics={metrics} />
+            </CardContent>
+        </Card>
+    );
+}
