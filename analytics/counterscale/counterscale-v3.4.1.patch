+export const ANALYTICS_ORIGIN = "https://ytpr.netlify.app";
+
+export function rejectInvalidAnalyticsOrigin(request: Request) {
+    if (request.headers.get("Origin") === ANALYTICS_ORIGIN) {
+        return null;
+    }
+
+    return new Response("Forbidden", { status: 403 });
+}
+
+export const analyticsCorsHeaders = {
+    "Access-Control-Allow-Origin": ANALYTICS_ORIGIN,
+    Vary: "Origin",
+} as const;
