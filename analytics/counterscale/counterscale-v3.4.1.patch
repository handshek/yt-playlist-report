diff --git a/packages/server/app/routes/resources.seo-funnel.tsx b/packages/server/app/routes/resources.seo-funnel.tsx
new file mode 100644
index 0000000..786626a
--- /dev/null
+++ b/packages/server/app/routes/resources.seo-funnel.tsx
@@ -0,0 +1,300 @@
+import { useEffect } from "react";
+import { useFetcher } from "react-router";
+import type { LoaderFunctionArgs } from "react-router";
+
+import type { SeoFunnelMetrics } from "~/analytics/query";
+import { Card, CardContent, CardHeader, CardTitle } from "~/components/ui/card";
+import { requireAuth } from "~/lib/auth";
+import type { SearchFilters } from "~/lib/types";
+import { getFiltersFromSearchParams, paramsFromUrl } from "~/lib/utils";
+
+const emptyMetrics: SeoFunnelMetrics = {
+    reportSubmits: 0,
+    reportSuccesses: 0,
+    reportErrors: { invalidUrl: 0, fetchFailed: 0 },
+    feedbackOpens: 0,
+    offerViews: 0,
+    feedbackSubmits: { yes: 0, no: 0 },
+    offerResponses: { yes: 0, maybe: 0, no: 0 },
+    useCases: [],
+    helpfulReasons: [],
+    missingReasons: [],
+    acquisitionSources: [],
+    contentCtaClicks: [],
+};
+
+function ResponseTable({
+    label,
+    responses,
+}: {
+    label: string;
+    responses: Array<{ slug: string; responses: number }>;
+}) {
+    return (
+        <table className="w-full text-sm">
+            <thead>
+                <tr className="border-b text-left">
+                    <th className="pb-2 font-medium">{label}</th>
+                    <th className="pb-2 text-right font-medium">Responses</th>
+                </tr>
+            </thead>
+            <tbody>
+                {responses.length ? (
+                    responses.map(({ slug, responses: count }) => (
+                        <tr key={slug} className="border-b last:border-0">
+                            <td className="py-2 pr-4">{slug}</td>
+                            <td className="py-2 text-right">{count}</td>
+                        </tr>
+                    ))
+                ) : (
+                    <tr>
+                        <td colSpan={2} className="py-3 text-muted-foreground">
+                            No responses yet
+                        </td>
+                    </tr>
+                )}
+            </tbody>
+        </table>
+    );
+}
+
+export async function loader({ context, request }: LoaderFunctionArgs) {
+    await requireAuth(request, context.cloudflare.env);
+    const { analyticsEngine } = context;
+    const { interval, site } = paramsFromUrl(request.url);
+    const url = new URL(request.url);
+    const timezone = url.searchParams.get("timezone") || "UTC";
+    const filters = getFiltersFromSearchParams(url.searchParams);
+
+    return {
+        seoFunnel: await analyticsEngine.getSeoFunnelMetrics(
+            site,
+            interval,
+            timezone,
+            filters,
+        ),
+    };
+}
+
+export function SeoFunnelSummary({ metrics }: { metrics: SeoFunnelMetrics }) {
+    const completionRate = metrics.reportSubmits
+        ? `${Math.round((metrics.reportSuccesses / metrics.reportSubmits) * 100)}%`
+        : "—";
+    const priceIntentRate = metrics.offerViews
+        ? `${Math.round((metrics.offerResponses.yes / metrics.offerViews) * 100)}% yes`
+        : "—";
+    const feedbackResponses =
+        metrics.feedbackSubmits.yes + metrics.feedbackSubmits.no;
+
+    return (
+        <div className="space-y-6">
+            <dl className="grid gap-4 sm:grid-cols-3">
+                <div>
+                    <dt className="text-sm text-muted-foreground">Submits</dt>
+                    <dd className="text-3xl font-semibold">
+                        {metrics.reportSubmits}
+                    </dd>
+                </div>
+                <div>
+                    <dt className="text-sm text-muted-foreground">Successes</dt>
+                    <dd className="text-3xl font-semibold">
+                        {metrics.reportSuccesses}
+                    </dd>
+                </div>
+                <div>
+                    <dt className="text-sm text-muted-foreground">
+                        Completion rate
+                    </dt>
+                    <dd className="text-3xl font-semibold">{completionRate}</dd>
+                </div>
+            </dl>
+
+            <div className="grid gap-4 sm:grid-cols-2">
+                <div className="rounded border p-3">
+                    <div className="text-sm text-muted-foreground">
+                        Invalid URL
+                    </div>
+                    <div className="text-2xl font-semibold">
+                        {metrics.reportErrors.invalidUrl}
+                    </div>
+                </div>
+                <div className="rounded border p-3">
+                    <div className="text-sm text-muted-foreground">
+                        Fetch failed
+                    </div>
+                    <div className="text-2xl font-semibold">
+                        {metrics.reportErrors.fetchFailed}
+                    </div>
+                </div>
+            </div>
+
+            <dl className="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
+                <div>
+                    <dt className="text-sm text-muted-foreground">
+                        Feedback opens
+                    </dt>
+                    <dd className="text-2xl font-semibold">
+                        {metrics.feedbackOpens}
+                    </dd>
+                </div>
+                <div>
+                    <dt className="text-sm text-muted-foreground">
+                        Feedback responses
+                    </dt>
+                    <dd className="text-2xl font-semibold">
+                        {feedbackResponses}
+                    </dd>
+                </div>
+                <div>
+                    <dt className="text-sm text-muted-foreground">
+                        Offer views
+                    </dt>
+                    <dd className="text-2xl font-semibold">
+                        {metrics.offerViews}
+                    </dd>
+                </div>
+                <div>
+                    <dt className="text-sm text-muted-foreground">
+                        Price intent
+                    </dt>
+                    <dd className="text-2xl font-semibold">
+                        {priceIntentRate}
+                    </dd>
+                    <div className="text-xs text-muted-foreground">
+                        {metrics.offerResponses.maybe} maybe ·{" "}
+                        {metrics.offerResponses.no} no
+                    </div>
+                </div>
+            </dl>
+
+            <div className="grid gap-6 lg:grid-cols-3">
+                <ResponseTable label="Use case" responses={metrics.useCases} />
+                <ResponseTable
+                    label="Useful feature"
+                    responses={metrics.helpfulReasons}
+                />
+                <ResponseTable
+                    label="Missing capability"
+                    responses={metrics.missingReasons}
+                />
+            </div>
+
+            <table className="w-full text-sm">
+                <thead>
+                    <tr className="border-b text-left">
+                        <th className="pb-2 font-medium">Acquisition source</th>
+                        <th className="pb-2 text-right font-medium">
+                            Visitors
+                        </th>
+                        <th className="pb-2 text-right font-medium">Reports</th>
+                        <th className="pb-2 text-right font-medium">
+                            Successes
+                        </th>
+                        <th className="pb-2 text-right font-medium">
+                            Completion
+                        </th>
+                        <th className="pb-2 text-right font-medium">
+                            Offer views
+                        </th>
+                        <th className="pb-2 text-right font-medium">
+                            Feedback
+                        </th>
+                    </tr>
+                </thead>
+                <tbody>
+                    {metrics.acquisitionSources.length ? (
+                        metrics.acquisitionSources.map((source) => (
+                            <tr
+                                key={source.source}
+                                className="border-b last:border-0"
+                            >
+                                <td className="py-2 pr-4">{source.source}</td>
+                                <td className="py-2 text-right">
+                                    {source.visitors}
+                                </td>
+                                <td className="py-2 text-right">
+                                    {source.reportSubmits}
+                                </td>
+                                <td className="py-2 text-right">
+                                    {source.reportSuccesses}
+                                </td>
+                                <td className="py-2 text-right">
+                                    {source.visitors
+                                        ? `${Math.round((source.reportSuccesses / source.visitors) * 100)}%`
+                                        : "—"}
+                                </td>
+                                <td className="py-2 text-right">
+                                    {source.offerViews}
+                                </td>
+                                <td className="py-2 text-right">
+                                    {source.feedbackSubmits}
+                                </td>
+                            </tr>
+                        ))
+                    ) : (
+                        <tr>
+                            <td
+                                colSpan={7}
+                                className="py-3 text-muted-foreground"
+                            >
+                                No attributed events yet
+                            </td>
+                        </tr>
+                    )}
+                </tbody>
+            </table>
+
+            <table className="w-full text-sm">
+                <thead>
+                    <tr className="border-b text-left">
+                        <th className="pb-2 font-medium">Content CTA</th>
+                        <th className="pb-2 text-right font-medium">Clicks</th>
+                    </tr>
+                </thead>
+                <tbody>
+                    {metrics.contentCtaClicks.map(({ slug, clicks }) => (
+                        <tr key={slug} className="border-b last:border-0">
+                            <td className="py-2 pr-4">{slug}</td>
+                            <td className="py-2 text-right">{clicks}</td>
+                        </tr>
+                    ))}
+                </tbody>
+            </table>
+        </div>
+    );
+}
+
+export function SeoFunnelCard({
+    siteId,
+    interval,
+    filters,
+    timezone,
+}: {
+    siteId: string;
+    interval: string;
+    filters: SearchFilters;
+    timezone: string;
+}) {
+    const dataFetcher = useFetcher<typeof loader>();
+    const metrics = dataFetcher.data?.seoFunnel || emptyMetrics;
+
+    useEffect(() => {
+        dataFetcher.submit(
+            { site: siteId, interval, timezone, ...filters },
+            { method: "get", action: "/resources/seo-funnel" },
+        );
+        // dataFetcher is intentionally stable and omitted from dependencies.
+        // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [siteId, interval, filters, timezone]);
+
+    return (
+        <Card className={dataFetcher.state === "loading" ? "opacity-60" : ""}>
+            <CardHeader>
+                <CardTitle>SEO Conversion Funnel</CardTitle>
+            </CardHeader>
+            <CardContent>
+                <SeoFunnelSummary metrics={metrics} />
+            </CardContent>
+        </Card>
+    );
+}
