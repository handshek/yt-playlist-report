diff --git a/packages/server/app/routes/resources.playlist-measurements.tsx b/packages/server/app/routes/resources.playlist-measurements.tsx
new file mode 100644
index 0000000..e8a15ae
--- /dev/null
+++ b/packages/server/app/routes/resources.playlist-measurements.tsx
@@ -0,0 +1,116 @@
+import { useEffect, useState } from "react";
+import { useFetcher } from "react-router";
+import type { LoaderFunctionArgs } from "react-router";
+
+import type { PlaylistMeasurement } from "~/analytics/query";
+import PaginationButtons from "~/components/PaginationButtons";
+import {
+    Card,
+    CardContent,
+    CardHeader,
+    CardTitle,
+} from "~/components/ui/card";
+import type { SearchFilters } from "~/lib/types";
+import {
+    getFiltersFromSearchParams,
+    paramsFromUrl,
+} from "~/lib/utils";
+import { requireAuth } from "~/lib/auth";
+
+export async function loader({ context, request }: LoaderFunctionArgs) {
+    await requireAuth(request, context.cloudflare.env);
+    const { analyticsEngine } = context;
+    const { interval, site, page = 1 } = paramsFromUrl(request.url);
+    const url = new URL(request.url);
+    const timezone = url.searchParams.get("timezone") || "UTC";
+    const filters = getFiltersFromSearchParams(url.searchParams);
+
+    return {
+        playlistMeasurements:
+            await analyticsEngine.getPlaylistMeasurements(
+                site,
+                interval,
+                timezone,
+                filters,
+                Number(page),
+            ),
+        page: Number(page),
+    };
+}
+
+export function PlaylistMeasurementsTable({
+    rows,
+}: {
+    rows: PlaylistMeasurement[];
+}) {
+    return (
+        <table className="w-full text-sm">
+            <thead>
+                <tr className="border-b text-left">
+                    <th className="pb-2 font-medium">Playlist ID</th>
+                    <th className="pb-2 text-right font-medium">
+                        Measurements
+                    </th>
+                </tr>
+            </thead>
+            <tbody>
+                {rows.map(({ playlistId, measurements }) => (
+                    <tr key={playlistId} className="border-b last:border-0">
+                        <td className="py-2 pr-4">
+                            <a
+                                className="text-primary underline-offset-4 hover:underline"
+                                href={`https://www.youtube.com/playlist?list=${encodeURIComponent(playlistId)}`}
+                                target="_blank"
+                                rel="noreferrer"
+                            >
+                                {playlistId}
+                            </a>
+                        </td>
+                        <td className="py-2 text-right">{measurements}</td>
+                    </tr>
+                ))}
+            </tbody>
+        </table>
+    );
+}
+
+export function PlaylistMeasurementsCard({
+    siteId,
+    interval,
+    filters,
+    timezone,
+}: {
+    siteId: string;
+    interval: string;
+    filters: SearchFilters;
+    timezone: string;
+}) {
+    const dataFetcher = useFetcher<typeof loader>();
+    const rows = dataFetcher.data?.playlistMeasurements || [];
+    const [page, setPage] = useState(1);
+
+    useEffect(() => {
+        dataFetcher.submit(
+            { site: siteId, interval, timezone, ...filters, page },
+            { method: "get", action: "/resources/playlist-measurements" },
+        );
+        // dataFetcher is intentionally stable and omitted from dependencies.
+        // eslint-disable-next-line react-hooks/exhaustive-deps
+    }, [siteId, interval, filters, timezone, page]);
+
+    return (
+        <Card className={dataFetcher.state === "loading" ? "opacity-60" : ""}>
+            <CardHeader>
+                <CardTitle>Playlist Measurements</CardTitle>
+            </CardHeader>
+            <CardContent>
+                <PlaylistMeasurementsTable rows={rows} />
+                <PaginationButtons
+                    page={page}
+                    hasMore={rows.length === 10}
+                    handlePagination={setPage}
+                />
+            </CardContent>
+        </Card>
+    );
+}
